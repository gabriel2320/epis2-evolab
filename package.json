{
  "name": "epis2-evolab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EPIS2 Evolab — laboratorio autónomo de simulación y evolución supervisada",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @evolab/demo-fixtures && npm run build -w @evolab/evolution-lab",
    "typecheck": "npm run build -w @evolab/demo-fixtures && npm run typecheck -w @evolab/demo-fixtures && npm run typecheck -w @evolab/evolution-lab && npm run typecheck -w @evolab/evolution-console",
    "test": "npm run build -w @evolab/demo-fixtures && vitest run",
    "evolab:doctor": "tsx apps/evolution-lab/src/cli.ts doctor",
    "evolab:models": "tsx apps/evolution-lab/src/cli.ts models",
    "evolab:scenarios": "tsx apps/evolution-lab/src/cli.ts scenarios",
    "evolab:run": "tsx apps/evolution-lab/src/cli.ts run",
    "evolab:runs": "tsx apps/evolution-lab/src/cli.ts runs",
    "evolab:findings": "tsx apps/evolution-lab/src/cli.ts findings",
    "evolab:replay": "tsx apps/evolution-lab/src/cli.ts replay",
    "evolab:plan": "tsx apps/evolution-lab/src/cli.ts plan",
    "evolab:import": "tsx apps/evolution-lab/src/cli.ts import",
    "evolab:queue": "tsx apps/evolution-lab/src/cli.ts queue",
    "evolab:review": "tsx apps/evolution-lab/src/cli.ts review",
    "evolab:report": "tsx apps/evolution-lab/src/cli.ts report",
    "evolab:regenerate": "tsx apps/evolution-lab/src/cli.ts regenerate",
    "evolab:validate": "node scripts/evolution/validate.mjs",
    "evolab:boundary:validate": "node scripts/evolution/boundary-validate.mjs",
    "evolab:db:migrate": "node scripts/evolution/db-migrate.mjs",
    "evolab:db:reset": "node scripts/evolution/db-reset.mjs",
    "evolab:stack": "node scripts/evolution/stack.mjs",
    "evolab:console": "tsx apps/evolution-console/src/server.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "postgres": "^3.4.5"
  }
}
